PORT=5000
CLIENT_URL=http://localhost:5173
CLIENT_URLS=http://localhost:5174
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<application-database>?retryWrites=true&w=majority
# Optional DNS servers for Node SRV resolution when the system resolver is unavailable.
MONGODB_DNS_SERVERS=
# Set to a unique random secret of at least 32 characters. Never commit real secrets.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
JSEARCH_API_KEY=
HIMALAYAS_API_KEY=
GEMINI_API_KEY=
# Current stable text model in Google's Gemini API model catalog; override if needed.
GEMINI_MODEL=gemini-3.6-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
UPSTASH_REDIS_URL=
SEED_SAMPLE_DATA=false
ENABLE_LIVE_DISCOVERY=true
NODE_ENV=development
